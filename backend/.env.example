# Extraction provider (the model that turns a brochure into structured product
# JSON): "gpt", "qwen", "gemini", or "claude".
#   - gpt: Qwen OCRs the brochure page images and GPT (OpenAI) turns that text
#          into the JSON. Every PDF goes image -> Qwen OCR -> text -> GPT, so
#          both OPENAI_* and QWEN_* below are required for provider=gpt.
# Set this to match the API key you provide below.
EXTRACTION_PROVIDER=gpt

# Provider for the AI search agent (text-only, converts a natural-language
# query into search filters). Leave empty to reuse EXTRACTION_PROVIDER.
SEARCH_PROVIDER=

# Claude API key from console.anthropic.com (needed only if provider=claude)
ANTHROPIC_API_KEY=

# Gemini API key from ai.google.dev (needed only if provider=gemini)
GEMINI_API_KEY=

# OpenAI GPT API key from platform.openai.com (needed when provider=gpt)
OPENAI_API_KEY=
# GPT model used for extraction (text in -> JSON out; no vision needed since
# Qwen does the OCR). gpt-4o-mini is a good default. Used when provider=gpt.
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base URL. Empty = OpenAI (api.openai.com, paid).
# Point at a FREE GPT-compatible gateway (e.g. GitHub Models, OpenRouter free
# tier, or a local server) to run provider=gpt without OpenAI billing.
OPENAI_API_BASE=

# Reference enrichment: when true, products with a CAS number get authoritative
# data (molecular formula, IUPAC name, PubChem CID) fetched from PubChem and
# attached under details.reference_data, clearly labelled as NOT from the
# brochure. Deterministic (no LLM); never affects dedup. Set false to disable.
PUBCHEM_ENRICHMENT=true

# NuExtract (NuMind hosted structured extraction) — needed only if
# provider=nuextract. With provider=nuextract, Qwen OCRs the brochure and
# NuExtract turns that text into the JSON. The cloud API is project-based +
# async: create a "structured extraction" project on nuextract.ai (its template
# defines the output schema), then put its id here.
NUEXTRACT_API_KEY=
NUEXTRACT_API_BASE=https://nuextract.ai/api
NUEXTRACT_PROJECT_ID=
# Gemini model used for extraction
GEMINI_MODEL=gemini-2.5-flash

# For GLM 
#The list shows all API keys associated with your account. Please keep them secure and do not share or expose them in browsers or client-side code.
#To protect your account, the platform may automatically rotate or revoke API keys that are detected as publicly exposed.
# Each API key issued by the platform consists of an API Key ID and a signature secret, in the following format: {API Key ID}.{secret}.



# Open Router API Key (for glm 4.6)
OPENROUTER_API_KEY=sk-or-v1-...
# Qwen vision OCR — for scanned / image-only PDFs (OpenAI-compatible endpoint)
# Works with Dashscope (Alibaba Cloud) or a local vLLM/Ollama deployment.
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

# Supabase project URL.
SUPABASE_URL=https://qpqdbyhfquqfrkrocnnu.supabase.co

# Service role key — FULL database access. Backend only, NEVER in the frontend.
SUPABASE_SERVICE_KEY=

# Anon key — public key mirrored from the frontend (used for reference).
SUPABASE_ANON_KEY=

# JWT secret (Project Settings -> API -> JWT Secret). Used to verify the
# signature of user access tokens on protected routes. Backend only.
SUPABASE_JWT_SECRET=

# Exact frontend origin allowed by CORS (no wildcard in production).
ALLOWED_ORIGIN=http://localhost:5173

# Max accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=20

# Claude model used for extraction (when provider=claude).
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Sourcing assistant (chat) ---
# The assistant ships dark; the /chat endpoints 503 until this is true.
CHAT_ENABLED=false

# --- Semantic index (P3) ---
# Needs db/migrations/2026-07-26_chemical_embeddings.sql AND a one-off
# `python -m app.embed_backfill`. Until both are done, the assistant's
# find_similar_chemicals degrades to a name match (and says so).
# Embeddings reuse QWEN_API_KEY / QWEN_API_BASE above — no new account.
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=text-embedding-v3
# Must match the vector(N) width in the migration.
EMBEDDING_DIM=1024
