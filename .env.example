# ─────────────────────────────────────────────────────────────
# Root env — used by the Supabase MCP server (see .mcp.json).
# Copy this file to .env and fill in the value. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# Supabase personal access token for the MCP server.
# Create one at: https://supabase.com/dashboard/account/tokens
# This is a MANAGEMENT token (starts with "sbp_"), NOT the app's
# anon/service keys. Keep it out of committed files — .mcp.json now
# reads it from this variable instead of hardcoding it.
SUPABASE_ACCESS_TOKEN=
qwen_api=